@page
@model ClinicaVeterinaraP1.Pages.Programari.IndexModel

@{
    ViewData["Title"] = "Programări";
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold">Gestionare Programări</h1>

    <img src="~/images/programare.png"
         alt="Calendar Programari"
         class="img-fluid rounded shadow-lg mt-3"
         style="max-height: 400px; width: auto; border: 1px solid #ddd;" />
</div>

<p>
    @if (!User.IsInRole("Medic"))
    {
        <a asp-page="Create">Create New</a>
    }
</p>

<table class="table table-hover table-striped">
    <thead class="thead-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Programare[0].DataOra)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Programare[0].Motiv)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Programare[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Programare[0].DataCreare)
            </th>
            <th>
                Animal
            </th>
            <th>
                Medic Veterinar
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Programare)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.DataOra)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Motiv)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataCreare)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Animal.Nume)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MedicVeterinar.Nume)
                    @Html.DisplayFor(modelItem => item.MedicVeterinar.Prenume)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ProgramareId">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ProgramareId">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ProgramareId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>